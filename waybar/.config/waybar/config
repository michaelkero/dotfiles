{
  "layer": "top",
  "position": "top",
  "modules-left": ["sway/workspaces"],
  "modules-right": ["network", "battery", "cpu", "memory", "custom/volume", "clock", "tray"],
  "network": {
    "format-wifi": "  {essid} ({signalStrength}%)",
    "format-ethernet": "󰈀  {ipaddr}/{cidr}",
    "format-disconnected": "  Offline",
    "tooltip-format": "{ifname} via {gwaddr}",
    "tooltip-format-wifi": "{essid} ({signalStrength}%)"
  },
  "battery": {
    "format": "   {capacity}%",
    "format-charging": " {capacity}% ⚡",
    "format-plugged": " {capacity}% 🔌",
    "format-icons": ["", "", "", "", ""]
  },
  "cpu": {
    "interval": 1,
    "format": "{icon} {usage}% ",
    "format-icons": ["▁", "▂", "▃", "▄", "▅", "▆", "▇", "█"]
  },
  "memory": {
    "interval": 30,
	"format": "{used:0.1f}G/{total:0.1f}G "
  },
  "clock": {
    "format": "{:%H:%M}",
    "tooltip-format": "{calendar}"
    // "tooltip-format": "{:%A, %d %B %Y}"
  },
  "custom/volume": {
    "exec": "waybar-volume",
    // "format": "{volume}% {icon}",
    "on-click": "waybar-volume click-left",
    "on-scroll-up": "waybar-volume scroll-up",
    "on-scroll-down": "waybar-volume scroll-down",
    "interval": 1,
    "return-type": "json"
  }// ,
  // "wireplumber": {
  //   "format": "{volume}% {icon}",
  //   "format-muted": " Muted",
  //   "format-icons": ["", "", ""], // Low, Medium, High
  //   "scroll-step": 5,
  //   "on-click": "pavucontrol" // Opens mixer on left click
  // }
}
