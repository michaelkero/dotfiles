export CONFIG_HOME="${HOME}/.config"
export XDG_CONFIG_HOME="${HOME}/.config"

# go exports
if [[ "$OSTYPE" == "linux-gnu" ]]; then
	export GO_ROOT=/usr/local/go
elif [[ "$OSTYPE" == "darwin" ]] then
	export GO_ROOT="/opt/homebrew/bin/go"
fi

export GOPATH="${HOME}/automata/go"
export GONOPROXY=
export GOPRIVATE=
export GOSUMDB=
export CGO_CFLAGS_ALLOW='-Xpreprocessor'
export CGO_ENABLED=1

# dot net
if [[ "$OSTYPE" == "linux-gnu" ]]; then
	export DOTNET_ROOT=$CONFIG_HOME/dotnet
elif [[ "$OSTYPE" == "darwin" ]] then
	export DOTNET_ROOT="/opt/homebrew/opt/dotnet/libexec"
fi

# rust
export CARGO_HOME=$CONFIG_HOME/rust

# jenv
export PATH="$HOME/.jenv/bin:$PATH"

# pyenv
export PYENV_ROOT="$HOME/.pyenv"
export PATH="$PYENV_ROOT/bin:$PATH"

# nvm
export NVM_DIR="$CONFIG_HOME/nvm"
if [[ "$OSTYPE" == "linux-gnu" ]]; then
    [ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"  # This loads nvm
    [ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"  # This loads nvm bash_completion
elif [[ "$OSTYPE" == "darwin" ]] then
    [ -s "/opt/homebrew/opt/nvm/nvm.sh" ] && \. "/opt/homebrew/opt/nvm/nvm.sh"  # This loads nvm
    [ -s "/opt/homebrew/opt/nvm/etc/bash_completion.d/nvm" ] && \. "/opt/homebrew/opt/nvm/etc/bash_completion.d/nvm"  # This loads nvm bash_completion
fi

# pnpm
export PNPM_HOME="~/.pnpm/store"
export PATH="$PNPM_HOME:$PATH"

# rbenv
if [[ "$OSTYPE" == "darwin" ]] then
    export RUBY_CONFIGURE_OPTS="--with-openssl-dir=$(brew --prefix openssl@1.1)"
    export CFLAGS="-Wno-error=implicit-function-declaration -Wcompound-token-split-by-macro"
fi

# protoc
export PROTOC_HOME=$CONFIG_HOME/protoc

# path
export PATH=$PATH:$GOPATH/bin
export PATH=$PATH:$CARGO_HOME/bin
export PATH=$PATH:$DOTNET_ROOT:$DOTNET_ROOT/tools
export PATH=$PATH:$CONFIG_HOME/neovim/bin
export PATH=$PATH:$PROTOC_HOME/bin
export PATH=$PATH:$HOME/.local/bin
export PATH=$PATH:/usr/local/go/bin
export PATH=$PATH:/usr/local/bin
export PATH=$PATH:/opt/homebrew/bin
export PATH=$PATH:/opt/homebrew/opt
export PATH=$PATH:/usr/pgadmin4/bin
