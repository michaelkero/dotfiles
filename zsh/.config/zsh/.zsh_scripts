#! /bin/bash 

# this parses the xinput of the xinput list to get the id of the buildin keyboard
KEYBOARD_DEVICE=$(xinput list | awk '/AT Translated Set 2 keyboard/ {split($7,a,"="); print a[2]}')

disablekb() {
    xinput float $KEYBOARD_DEVICE
}

enablekb() {
    xinput reattach $KEYBOARD_DEVICE 3
}

temporalup() {
    cd ~/automata/repos/others/temporalio/docker-compose/
    docker-compose up
}

temporaldown() {
    cd ~/automata/repos/others/temporalio/docker-compose/
    docker-compose down
}
