#! /bin/bash 

# this parses the xinput of the xinput list to get the id of the buildin keyboard
KEYBOARD_DEVICE=$(xinput list | awk '/AT Translated Set 2 keyboard/ {split($7,a,"="); print a[2]}')
TOUCHPAD_DEVICE=$(xinput list | awk '/VEN_06CB:00 06CB:CE7E Touchpad/ {split($7,a,"="); print a[2]}')

disablekb() {
    xinput float $KEYBOARD_DEVICE
}

enablekb() {
    xinput reattach $KEYBOARD_DEVICE 3
}

temporalup() {
    cd ~/automata/repos/others/temporalio/docker-compose/
    docker-compose up
}

temporaldown() {
    cd ~/automata/repos/others/temporalio/docker-compose/
    docker-compose down
}

endsess() {
    openvpn3 sessions-list | grep Path: | awk '{print $2}' | while read -r line ; do
        echo "Closing connection $line"
        openvpn3 session-manage --session-path $line --disconnect
    done
}
